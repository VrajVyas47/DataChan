# ====================================================
# DATA-CHAN Virtual Database Lab - Environment Configuration
# ====================================================

# ----------------------------------------------------
# 1. Node.js API Backend Configuration
# ----------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Platform metadata & user records)
MONGODB_URI=mongodb://localhost:27017
MONGODB_PLATFORM_DB=datachan_platform

# Query Execution Sandbox Guardrails
MAX_QUERY_EXECUTION_MS=5000
MAX_RESULT_DOCUMENTS=100
MAX_DOCUMENT_SIZE_BYTES=1048576

# Session Cookie & Security Configuration
SESSION_COOKIE_NAME=datachan_session
SESSION_EXPIRATION_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin SDK (Server-Side Authentication Authority)
# In production, provide credentials via Service Account or GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_PROJECT_ID=datachan-auth
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@datachan-auth.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Optional: Local Firebase Auth Emulator (Leave empty if using live Firebase or service account)
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ----------------------------------------------------
# 2. Next.js Frontend Configuration
# ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Firebase Client SDK Configuration (Safe for browser)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleApiKey1234567890
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=datachan-auth.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=datachan-auth
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=datachan-auth.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Firebase Auth Emulator URL for browser
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# Optional: Development Quick Demo Prefill Emails (Development Only - Non-secret)
NEXT_PUBLIC_DEV_PREFILL_STUDENT_EMAIL=student@datachan.org
NEXT_PUBLIC_DEV_PREFILL_FACULTY_EMAIL=faculty@datachan.org
NEXT_PUBLIC_DEV_PREFILL_ADMIN_EMAIL=admin@datachan.org
