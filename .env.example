# ====================================================
# DATA-CHAN Virtual Database Lab — Unified Monorepo Configuration
# ====================================================
# For package-specific environment setups, refer to:
#   Backend: apps/api/.env.example
#   Frontend: apps/web/.env.example
# ====================================================

# ----------------------------------------------------
# 1. Node.js API Backend Configuration (Server-Only)
# ----------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection (Single source of truth)
MONGODB_URI=mongodb://localhost:27017
MONGODB_PLATFORM_DB=datachan_platform

# Query Execution Sandbox Guardrails
MAX_QUERY_EXECUTION_MS=5000
MAX_RESULT_DOCUMENTS=100
MAX_DOCUMENT_SIZE_BYTES=1048576

# Session Cookie & Security Configuration (Consistent 7 days)
SESSION_COOKIE_NAME=datachan_session
SESSION_EXPIRATION_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Firebase Admin SDK (Authentication Authority)
# Mode A: Firebase Auth Emulator (Recommended for local dev)
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=demo-datachan

# Mode B: Production / Live Firebase Service Account
# FIREBASE_PROJECT_ID=datachan-auth
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@datachan-auth.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ----------------------------------------------------
# 2. Next.js Frontend Configuration (Browser-Safe)
# ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Firebase Client SDK Configuration (Public Web Config)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-datachan.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-datachan
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-datachan.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# Administrative Portal Gate
NEXT_PUBLIC_ENABLE_ADMIN_PORTAL=true

# Development Non-Secret Prefill Helpers
NEXT_PUBLIC_DEV_PREFILL_STUDENT_EMAIL=student@datachan.org
NEXT_PUBLIC_DEV_PREFILL_FACULTY_EMAIL=faculty@datachan.org
NEXT_PUBLIC_DEV_PREFILL_ADMIN_EMAIL=admin@datachan.org
