# ====================================================
# DATA-CHAN API — Backend Environment Configuration
# ====================================================

PORT=5000
NODE_ENV=development

# ----------------------------------------------------
# MongoDB Database Configuration (Single Source of Truth)
# ----------------------------------------------------
# For Local unauthenticated MongoDB (Standard development):
MONGODB_URI=mongodb://localhost:27017
MONGODB_PLATFORM_DB=datachan_platform

# For Authenticated MongoDB / MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/datachan_platform?retryWrites=true&w=majority

# ----------------------------------------------------
# Query Execution Sandbox Guardrails
# ----------------------------------------------------
MAX_QUERY_EXECUTION_MS=5000
MAX_RESULT_DOCUMENTS=100
MAX_DOCUMENT_SIZE_BYTES=1048576

# ----------------------------------------------------
# Session Cookie & Security Configuration
# ----------------------------------------------------
SESSION_COOKIE_NAME=datachan_session
SESSION_EXPIRATION_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------------------------------
# Firebase Admin SDK (Authentication Authority)
# ----------------------------------------------------
# Mode 1: Local Firebase Auth Emulator (Recommended for local dev)
# Connects to the local Firebase Auth emulator without requiring service account keys.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_PROJECT_ID=demo-datachan

# Mode 2: Live Firebase Project with Service Account (Production / Live Dev)
# In production, provide credentials via Service Account or GOOGLE_APPLICATION_CREDENTIALS
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Mode 3: Google Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-file.json
