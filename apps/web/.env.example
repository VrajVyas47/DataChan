# ====================================================
# DATA-CHAN Web App — Frontend Environment Configuration
# ====================================================

# Backend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ----------------------------------------------------
# Firebase Client SDK Configuration (Public Web Config)
# ----------------------------------------------------
# NOTE: Web API keys identify your Firebase project in the browser.
# They are public by design, but MUST NOT be used as server credentials.
# Never expose FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY, or MongoDB credentials here.

# Mode 1: Local Firebase Auth Emulator (Recommended for local dev)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-datachan.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-datachan
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-datachan.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:demo123456
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# Mode 2: Live Firebase Project (Production / Live Dev)
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleApiKey1234567890
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
# NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ----------------------------------------------------
# Administrative Portal Gate
# ----------------------------------------------------
# Set to 'true' to display admin link in navigation for admin users.
# Note: Backend API routes strictly enforce admin authorization regardless of this flag.
NEXT_PUBLIC_ENABLE_ADMIN_PORTAL=true

# ----------------------------------------------------
# Development Login Prefill (Non-secret email helpers)
# ----------------------------------------------------
NEXT_PUBLIC_DEV_PREFILL_STUDENT_EMAIL=student@datachan.org
NEXT_PUBLIC_DEV_PREFILL_FACULTY_EMAIL=faculty@datachan.org
NEXT_PUBLIC_DEV_PREFILL_ADMIN_EMAIL=admin@datachan.org
